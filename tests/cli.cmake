file(MAKE_DIRECTORY "${WORK}")
function(run_ok)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Command failed (${code}): ${error}")
  endif()
  set(result "${output}" PARENT_SCOPE)
endfunction()
run_ok("${SEARCH}" --history "${FIXTURES}/history.csv" --queries "${FIXTURES}/queries.csv" --mode top-k --k 3)
set(expected "query_id,event_id,timestamp,score\n100,2,3999,1\n100,3,3999,1\n100,4,400,1\n")
if(NOT result STREQUAL expected)
  message(FATAL_ERROR "Incorrect top-k CSV: ${result}")
endif()
run_ok("${SEARCH}" --backend sequential --history "${FIXTURES}/history.csv" --queries "${FIXTURES}/queries.csv" --mode top-k --k 3)
if(NOT result STREQUAL expected)
  message(FATAL_ERROR "Explicit sequential backend differs from default: ${result}")
endif()
run_ok("${SEARCH}" --history "${FIXTURES}/history.csv" --queries "${FIXTURES}/queries.csv" --mode threshold --threshold 0.75)
string(APPEND expected "100,1,4000,0.75\n")
if(NOT result STREQUAL expected)
  message(FATAL_ERROR "Incorrect threshold CSV: ${result}")
endif()
run_ok("${SEARCH}" --backend sequential --history "${FIXTURES}/history.csv" --queries "${FIXTURES}/queries.csv" --mode threshold --threshold 0.75)
if(NOT result STREQUAL expected)
  message(FATAL_ERROR "Explicit sequential threshold differs from default: ${result}")
endif()
# Resolve the backend before attempting to open input files or emitting CSV.
foreach(backend openmp mpi opencl unknown)
  execute_process(COMMAND "${SEARCH}" --backend "${backend}" --history "${WORK}/missing-history.csv" --queries "${WORK}/missing-queries.csv"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT code EQUAL 1 OR NOT output STREQUAL "")
    message(FATAL_ERROR "Unavailable/unknown backend produced results or succeeded: ${backend}")
  endif()
  if(backend STREQUAL "unknown")
    set(expected_error "Unknown backend: unknown")
  else()
    set(expected_error "Backend ${backend} is not available")
  endif()
  string(FIND "${error}" "${expected_error}" error_position)
  if(error_position EQUAL -1)
    message(FATAL_ERROR "Incorrect error for backend ${backend}: ${error}")
  endif()
endforeach()
execute_process(COMMAND "${SEARCH}" --backend RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 1 OR NOT output STREQUAL "" OR NOT error MATCHES "Missing value: --backend")
  message(FATAL_ERROR "Missing backend value was not reported correctly: ${error}")
endif()
run_ok("${SEARCH}" --help)
if(NOT result MATCHES "--backend sequential\\|openmp\\|mpi\\|opencl")
  message(FATAL_ERROR "Help does not describe backend selection")
endif()
run_ok("${GENERATE}" --history "${WORK}/history.csv" --queries "${WORK}/queries.csv" --count 100 --query-count 5 --features 7 --seed 1337)
file(SHA256 "${WORK}/history.csv" first_history)
file(SHA256 "${WORK}/queries.csv" first_queries)
run_ok("${GENERATE}" --history "${WORK}/history.csv" --queries "${WORK}/queries.csv" --count 100 --query-count 5 --features 7 --seed 1337)
file(SHA256 "${WORK}/history.csv" second_history)
file(SHA256 "${WORK}/queries.csv" second_queries)
if(NOT first_history STREQUAL second_history OR NOT first_queries STREQUAL second_queries)
  message(FATAL_ERROR "CLI generator is not repeatable")
endif()
run_ok("${SEARCH}" --history "${WORK}/history.csv" --queries "${WORK}/queries.csv" --k 3)
string(REGEX MATCHALL "\n" lines "${result}")
list(LENGTH lines line_count)
if(NOT line_count EQUAL 16)
  message(FATAL_ERROR "Expected header + 5*3 matches, received ${line_count} lines")
endif()
execute_process(COMMAND "${SEARCH}" --k -1 RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 1)
  message(FATAL_ERROR "Invalid CLI argument was accepted")
endif()
execute_process(COMMAND "${GENERATE}" --history "${WORK}/same.csv" --queries "${WORK}/same.csv"
  RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 1)
  message(FATAL_ERROR "Overlapping output paths were accepted")
endif()
